# Agent Journey 60d — 环境配置模板

# OpenAI Compatible API (支持任意兼容OpenAI格式的provider)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# 数据库（可选，后续章节使用）
DATABASE_URL=postgresql://user:password@localhost:5432/agent_journey
REDIS_URL=redis://localhost:6379/0
